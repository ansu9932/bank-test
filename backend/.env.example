

# ─── FX / Currency ────────────────────────────────────────────────────────────
# Deposits are entered in USD but the UPI/Razorpay rail settles in INR. The live
# USD→INR rate is fetched from a public FX feed; this value is used ONLY as a
# fallback when that feed is unreachable. Optional (defaults to 90).
USD_INR_FALLBACK_RATE=90


# ─── Email / SMTP (Brevo transactional relay) ─────────────────────────────────
# Brevo (smtp-relay.brevo.com) is used for all transactional email.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Your Brevo SMTP login (looks like 8a24d3001@smtp-brevo.com)
SMTP_USER=8a24d3001@smtp-brevo.com
# Your Brevo SMTP KEY (NOT your account password). Create it in Brevo →
# SMTP & API → SMTP. Keep this secret; never commit it.
SMTP_PASS=your-brevo-smtp-key

# The visible "From" address. MUST be a sender you VERIFIED in Brevo
# (Brevo → Senders, Domains & Dedicated IPs). It must NOT be the SMTP login.
EMAIL_FROM=no-reply@alisterbank.online
EMAIL_FROM_NAME=Alister Bank

# Optional SMTP pool tuning (sensible defaults applied if omitted).
# SMTP_MAX_CONNECTIONS=5
# SMTP_MAX_MESSAGES=100
# SMTP_RATE_LIMIT=10

# ─── Transactional SMS (Twilio / Brevo) ──────────────────────────────────────
# Used for the SWIFT approval notification sent to the customer's mobile.
# The ACTIVE provider is chosen from the admin panel (Admin → SMS Settings) and
# stored in the database. This optional var only sets the fallback default when
# no admin choice has been saved yet ('twilio' | 'brevo', defaults to twilio).
# SMS_PROVIDER=twilio
# Find these in Twilio Console → Account Info (https://console.twilio.com).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Your Twilio phone number in E.164 format (Console → Phone Numbers).
TWILIO_FROM_NUMBER=+15551234567
# OPTIONAL: Messaging Service SID ("MG..."). If set, it is used instead of
# TWILIO_FROM_NUMBER. Recommended for India (DLT) / high-volume sending.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default country code applied to bare 10-digit numbers (91 = India).
# SMS_DEFAULT_COUNTRY_CODE=91

# ── Brevo Transactional SMS (used when 'brevo' is selected in Admin → SMS Settings) ──
# API v3 key: Brevo → SMTP & API → API Keys (NOT the SMTP key used above).
BREVO_API_KEY=your-brevo-api-v3-key
# Sender shown on the SMS: alphanumeric max 11 chars (e.g. ALSTER) or a phone
# number max 15 digits. Must be allowed by your Brevo SMS plan/region rules.
BREVO_SMS_SENDER=ALSTER
