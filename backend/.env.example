

# ─── Core Secrets (REQUIRED) ───────────────────────────────────────────────────
# JWT secret used to sign access tokens. Must be ≥32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production

# ─── Database Configuration (REQUIRED) ─────────────────────────────────────────
# MySQL connection. On Hostinger VPS, these are provided by the hosting panel.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alister_bank
DB_USER=root
DB_PASS=your-mysql-password
# Connection pool tuning (optional; sensible defaults if omitted)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
# Schema sync mode. Set to 'true' ONLY for a single deploy after model changes,
# then REMOVE the flag immediately (dangerous if left on).
DB_SYNC_ALTER=false

# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# PM2 cluster instance number (set by ecosystem.config.js; do not edit in .env)
# NODE_APP_INSTANCE=0

# ─── API URLs (for CORS + client redirects) ──────────────────────────────────
# The backend's public URL (used by frontend for API calls)
API_PUBLIC_URL=https://api.alisterbank.online
# Frontend URL (for login redirects, email links, etc.)
FRONTEND_URL=https://alisterbank.online

# ─── FX / Currency ────────────────────────────────────────────────────────────
# Deposits are entered in USD but the UPI/Razorpay rail settles in INR. The live
# USD→INR rate is fetched from a public FX feed; this value is used ONLY as a
# fallback when that feed is unreachable. Optional (defaults to 90).
USD_INR_FALLBACK_RATE=90

# ─── Email / SMTP (Brevo transactional relay) ─────────────────────────────────
# Brevo (smtp-relay.brevo.com) is used for all transactional email.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Your Brevo SMTP login (looks like 8a24d3001@smtp-brevo.com)
SMTP_USER=8a24d3001@smtp-brevo.com
# Your Brevo SMTP KEY (NOT your account password). Create it in Brevo →
# SMTP & API → SMTP. Keep this secret; never commit it.
SMTP_PASS=your-brevo-smtp-key
# The visible "From" address. MUST be a sender you VERIFIED in Brevo
# (Brevo → Senders, Domains & Dedicated IPs). It must NOT be the SMTP login.
EMAIL_FROM=no-reply@alisterbank.online
EMAIL_FROM_NAME=Alister Bank
# Optional SMTP pool tuning (sensible defaults applied if omitted).
# SMTP_MAX_CONNECTIONS=5
# SMTP_MAX_MESSAGES=100
# SMTP_RATE_LIMIT=10

# ─── Transactional SMS (Twilio / Brevo) ──────────────────────────────────────
# Used for the SWIFT approval notification sent to the customer's mobile.
# The ACTIVE provider is chosen from the admin panel (Admin → SMS Settings) and
# stored in the database. This optional var only sets the fallback default when
# no admin choice has been saved yet ('twilio' | 'brevo', defaults to twilio).
SMS_PROVIDER=twilio
# Find these in Twilio Console → Account Info (https://console.twilio.com).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Your Twilio phone number in E.164 format (Console → Phone Numbers).
TWILIO_FROM_NUMBER=+15551234567
# OPTIONAL: Messaging Service SID ("MG..."). If set, it is used instead of
# TWILIO_FROM_NUMBER. Recommended for India (DLT) / high-volume sending.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default country code applied to bare 10-digit numbers (91 = India).
SMS_DEFAULT_COUNTRY_CODE=91

# ── Brevo Transactional SMS (used when 'brevo' is selected in Admin → SMS Settings) ──
# API v3 key: Brevo → SMTP & API → API Keys (NOT the SMTP key used above).
BREVO_API_KEY=your-brevo-api-v3-key
# Sender shown on the SMS: alphanumeric max 11 chars (e.g. ALSTER) or a phone
# number max 15 digits. Must be allowed by your Brevo SMS plan/region rules.
BREVO_SMS_SENDER=ALSTER

# ─── JWT / Auth Configuration ─────────────────────────────────────────────────
# Access token expiry (in minutes; default 15)
JWT_EXPIRE=15
# Bcrypt rounds for password hashing (higher = slower = more secure; default 12)
BCRYPT_ROUNDS=12

# ─── Payment Rails & Transfer Limits ──────────────────────────────────────────
# Minimum transfer amount that triggers OTP verification (in dollars)
TRANSFER_OTP_THRESHOLD=10000
# NEFT / RTGS / IMPS / UPI ETA labels (for UI display)
NEFT_ETA_LABEL=2-3 Business Days
# Razorpay Key ID (Razorpay Dashboard → Settings → API Keys)
# RAZORPAY_KEY_ID=rzp_live_xxxxx
# Razorpay Key Secret (KEEP SECRET; never commit)
# RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── Bank Details (for PDF statements, wire routing, etc.) ────────────────────
# SWIFT Code for the bank (shown on account statements)
BANK_SWIFT=ALSTINBB
# Bank name (shown on receipts / statements)
BANK_NAME=Alister Bank

# ─── Android App Configuration ───────────────────────────────────────────────
# Latest version available for download (semantic version, e.g. "1.0.2")
APP_LATEST_VERSION=1.0.0
# APK download URL (used by UpdateCheck middleware)
APP_APK_URL=https://downloads.alisterbank.online/AlisterBank.apk
# If true, force all clients to upgrade (no bypass allowed)
APP_FORCE_UPDATE=false

# ─── Logging & Monitoring ────────────────────────────────────────────────────
# Log level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info
# Optional: Sentry DSN for error tracking (leave blank to disable)
# SENTRY_DSN=https://xxxxx@sentry.io/project-id

